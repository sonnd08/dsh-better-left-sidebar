{
  "name": "dsh-better-left-sidebar",
  "version": "0.1.0",
  "description": "A DeepSeek Harness plugin: a small icon rail and a conversation column with search, new chat, pinned and recents.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/sonnd08/dsh-better-left-sidebar.git" },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsdown",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["slots", "locale"] }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  }
}
